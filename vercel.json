{
  "buildCommand": "node scripts/patch-performance-v2.mjs && npm run build",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/berita",
      "destination": "/api/share-berita"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}