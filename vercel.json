{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/patch-performance-v2.mjs && node scripts/patch-gallery-source.mjs && node scripts/patch-gallery-share-preview.mjs && npm run build",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/berita",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/share-berita"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "gallery"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/share-galeri"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
